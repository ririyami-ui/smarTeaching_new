rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Defensive ownership check (prevents error if userId field is missing)
    function isDocOwner() {
      return isAuthenticated() && (
        resource == null || 
        resource.data.get('userId', '') == request.auth.uid
      );
    }

    // Defensive writing check for data being sent
    function isWritingOwner() {
      return isAuthenticated() && (
        request.resource == null || 
        request.resource.data.get('userId', '') == request.auth.uid
      );
    }

    // --- 1. Identity & Communication ---
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }
    match /chats/{userId} {
      allow read, write: if isOwner(userId);
    }

    // --- 2. Academic Programs (Complex Access) ---
    match /teachingPrograms/{docId} {
      allow read: if isAuthenticated() && (
        docId.matches(request.auth.uid + '_.*') || 
        resource.data.get('userId', '') == request.auth.uid
      );
      allow write: if isAuthenticated() && (
        docId.matches(request.auth.uid + '_.*') || 
        request.resource.data.get('userId', '') == request.auth.uid
      );
    }

    // --- 3. Master Data & Journals ---
    match /classes/{docId} { allow read, write: if isDocOwner() && isWritingOwner(); }
    match /subjects/{docId} { allow read, write: if isDocOwner() && isWritingOwner(); }
    match /holidays/{docId} { allow read, write: if isDocOwner() && isWritingOwner(); }
    match /teachingSchedules/{docId} { allow read, write: if isDocOwner() && isWritingOwner(); }
    match /schedules/{docId} { allow read, write: if isDocOwner() && isWritingOwner(); }
    match /teachingJournals/{docId} { allow read, write: if isDocOwner() && isWritingOwner(); }

    // --- 4. Students & Performance ---
    match /students/{docId} { allow read, write: if isDocOwner() && isWritingOwner(); }
    match /legendStudents/{docId} { allow read, write: if isDocOwner() && isWritingOwner(); }
    match /attendance/{docId} { allow read, write: if isDocOwner() && isWritingOwner(); }
    match /absensi/{docId} { allow read, write: if isDocOwner() && isWritingOwner(); }
    match /grades/{docId} { allow read, write: if isDocOwner() && isWritingOwner(); }
    match /studentTasks/{docId} { allow read, write: if isDocOwner() && isWritingOwner(); }
    match /studentNotes/{docId} { allow read, write: if isDocOwner() && isWritingOwner(); }
    match /kktpAssessments/{docId} { allow read, write: if isDocOwner() && isWritingOwner(); }

    // --- 5. Content & Conduct ---
    match /lessonPlans/{docId} { allow read, write: if isDocOwner() && isWritingOwner(); }
    match /quizzes/{docId} { allow read, write: if isDocOwner() && isWritingOwner(); }
    match /handouts/{docId} { allow read, write: if isDocOwner() && isWritingOwner(); }
    match /lkpd_history/{docId} { allow read, write: if isDocOwner() && isWritingOwner(); }
    match /infractions/{docId} { allow read, write: if isDocOwner() && isWritingOwner(); }
    match /infraction_types/{docId} { allow read, write: if isDocOwner() && isWritingOwner(); }
    match /class_agreements/{docId} { allow read, write: if isDocOwner() && isWritingOwner(); }
    match /studentAppreciations/{docId} { allow read, write: if isDocOwner() && isWritingOwner(); }

    // --- 6. Safety Catch-all ---
    match /{collection}/{docId} {
      allow read: if isDocOwner();
      allow create: if isWritingOwner();
      allow update, delete: if isAuthenticated() && 
        resource.data.get('userId', '') == request.auth.uid;
    }
  }
}