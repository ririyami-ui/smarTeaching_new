rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Defensive ownership check (prevents error if userId field is missing)
    function isDocOwner() {
      return isAuthenticated() && (
        resource == null || 
        resource.data.get('userId', '') == request.auth.uid
      );
    }

    // Defensive writing check for data being sent
    function isWritingOwner() {
      return isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
    }

    // Check if data has required fields for creation
    function isValidCreate() {
      return request.resource.data.userId == request.auth.uid;
    }

    // Validate document structure for grades
    function isValidGrade() {
      return request.resource.data.keys().hasAll(['userId', 'studentId', 'score', 'date', 'semester', 'academicYear'])
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= 100;
    }

    // Validate document structure for attendance
    function isValidAttendance() {
      return request.resource.data.keys().hasAll(['userId', 'studentId', 'status', 'date', 'semester', 'academicYear'])
        && request.resource.data.status in ['Hadir', 'Sakit', 'Izin', 'Alpa', 'Terlambat'];
    }

    // --- 1. Identity & Communication ---
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }
    match /chats/{userId} {
      allow read, write: if isOwner(userId);
    }

    // --- 2. Academic Programs (Complex Access) ---
    match /teachingPrograms/{docId} {
      allow read: if isDocOwner();
      allow write: if isWritingOwner() && isValidCreate();
      allow delete: if isDocOwner();
    }

    // --- 3. Master Data & Journals ---
    match /classes/{docId} { 
      allow read: if isDocOwner();
      allow write: if isWritingOwner() && isValidCreate();
      allow delete: if isDocOwner(); 
    }
    match /subjects/{docId} { 
      allow read: if isDocOwner();
      allow write: if isWritingOwner() && isValidCreate();
      allow delete: if isDocOwner(); 
    }
    match /holidays/{docId} { 
      allow read: if isDocOwner();
      allow write: if isWritingOwner() && isValidCreate();
      allow delete: if isDocOwner(); 
    }
    match /teachingSchedules/{docId} { 
      allow read: if isDocOwner();
      allow write: if isWritingOwner() && isValidCreate();
      allow delete: if isDocOwner(); 
    }
    match /schedules/{docId} { 
      allow read: if isDocOwner();
      allow write: if isWritingOwner() && isValidCreate();
      allow delete: if isDocOwner(); 
    }
    match /teachingJournals/{docId} { 
      allow read: if isDocOwner();
      allow write: if isWritingOwner() && isValidCreate();
      allow delete: if isDocOwner(); 
    }

    // --- 4. Students & Performance ---
    match /students/{docId} { 
      allow read: if isDocOwner();
      allow write: if isWritingOwner() && isValidCreate();
      allow delete: if isDocOwner(); 
    }
    match /legendStudents/{docId} { 
      allow read: if isDocOwner();
      allow write: if isWritingOwner() && isValidCreate();
      allow delete: if isDocOwner(); 
    }
    match /attendance/{docId} { 
      allow read: if isDocOwner();
      allow create: if isWritingOwner() && isValidAttendance();
      allow update: if isWritingOwner();
      allow delete: if isDocOwner(); 
    }
    match /absensi/{docId} { 
      allow read: if isDocOwner();
      allow write: if isWritingOwner() && isValidCreate();
      allow delete: if isDocOwner(); 
    }
    match /grades/{docId} { 
      allow read: if isDocOwner();
      allow create: if isWritingOwner() && isValidGrade();
      allow update: if isWritingOwner();
      allow delete: if isDocOwner();
    }
    match /studentTasks/{docId} { 
      allow read: if isDocOwner();
      allow write: if isWritingOwner() && isValidCreate();
      allow delete: if isDocOwner(); 
    }
    match /studentNotes/{docId} { 
      allow read: if isDocOwner();
      allow write: if isWritingOwner() && isValidCreate();
      allow delete: if isDocOwner(); 
    }
    match /kktpAssessments/{docId} { 
      allow read: if isDocOwner();
      allow write: if isWritingOwner() && isValidCreate();
      allow delete: if isDocOwner(); 
    }

    // --- 5. Content & Conduct ---
    match /lessonPlans/{docId} { 
      allow read: if isDocOwner();
      allow write: if isWritingOwner() && isValidCreate();
      allow delete: if isDocOwner(); 
    }
    match /quizzes/{docId} { 
      allow read: if isDocOwner();
      allow write: if isWritingOwner() && isValidCreate();
      allow delete: if isDocOwner(); 
    }
    match /handouts/{docId} { 
      allow read: if isDocOwner();
      allow write: if isWritingOwner() && isValidCreate();
      allow delete: if isDocOwner(); 
    }
    match /lkpd_history/{docId} { 
      allow read: if isDocOwner();
      allow write: if isWritingOwner() && isValidCreate();
      allow delete: if isDocOwner(); 
    }
    match /infractions/{docId} { 
      allow read: if isDocOwner();
      allow write: if isWritingOwner() && isValidCreate();
      allow delete: if isDocOwner(); 
    }
    match /infraction_types/{docId} { 
      allow read: if isDocOwner();
      allow write: if isWritingOwner() && isValidCreate();
      allow delete: if isDocOwner(); 
    }
    match /class_agreements/{docId} { 
      allow read: if isDocOwner();
      allow write: if isWritingOwner() && isValidCreate();
      allow delete: if isDocOwner(); 
    }
    match /studentAppreciations/{docId} { 
      allow read: if isDocOwner();
      allow write: if isWritingOwner() && isValidCreate();
      allow delete: if isDocOwner(); 
    }

    // --- 6. Safety Catch-all (BLOCK unlisted collections) ---
    match /{collection}/{docId} {
      allow read, write: if false;
    }
  }
}